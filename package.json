{
  "name": "expense-tracker",
  "version": "0.1.0",
  "description": "Personal expense tracker for HDFC Bank: local-first Mac app",
  "main": "./out/main/index.js",
  "author": "Sundar S",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "package": "electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "ai": "^7.0.137",
    "better-sqlite3": "^13.0.3",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "imapflow": "^2.4.0",
    "mailparser": "^3.9.38",
    "pdfjs-dist": "^6.4.299",
    "vue-echarts": "^8.3.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.17.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pinia": "^4.0.3",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.12"
  }
}
